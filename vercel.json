{
  "version": 2,
  "name": "ministry-of-groove-grid",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*).(jpg|jpeg|png|gif|webp|svg|css|js|json)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/index", "destination": "/index.html" },
    { "source": "/terminal", "destination": "/terminal.html" },
    { "source": "/dossier", "destination": "/dossier.html" },
    { "source": "/archives", "destination": "/archives.html" },
    { "source": "/gallery", "destination": "/gallery.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/tos", "destination": "/tos.html" },
    { "source": "/404", "destination": "/404.html" }
  ],
  "errorPages": [
    { "status": 404, "path": "/404.html" }
  ]
}
