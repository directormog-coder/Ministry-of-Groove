{
  "env": {
    "browser": true,
    "es2022": true,
    "node": true,
    "worker": true,
    "serviceworker": true
  },
  "extends": [
    "eslint:recommended",
    "next/core-web-vitals"
  ],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }],
    "no-console": "off",
    "no-undef": "error",
    "no-var": "warn",
    "prefer-const": "warn",
    "eqeqeq": ["warn", "always"],
    "no-unreachable": "error"
  },
  "globals": {
    "Alpine": "readonly",
    "supabase": "readonly",
    "lucide": "readonly",
    "sb": "readonly",
    "MOGAuth": "readonly",
    "MOGCrypto": "readonly",
    "MOG_FALLBACK_CONFIG": "readonly",
    "MOG_ENV": "readonly",
    "CONFIG": "readonly",
    "hub": "readonly",
    "dossierPage": "readonly",
    "commandCenter": "readonly"
  }
}
