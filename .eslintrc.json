{
  "env": {
    "browser":  true,
    "es2022":   true,
    "worker":   true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType":  "script"
  },
  "rules": {
    "no-unused-vars":    ["warn", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }],
    "no-console":        "off",
    "no-undef":          "error",
    "no-var":            "warn",
    "prefer-const":      "warn",
    "eqeqeq":            ["warn", "always"],
    "no-duplicate-keys": "error",
    "no-unreachable":    "error"
  },
  "globals": {
    "Alpine":              "readonly",
    "supabase":            "readonly",
    "lucide":              "readonly",
    "sb":                  "readonly",
    "MOGAuth":             "readonly",
    "MOGCrypto":           "readonly",
    "MOG_FALLBACK_CONFIG": "readonly",
    "MOG_ENV":             "readonly",
    "CONFIG":              "readonly",
    "hub":                 "readonly",
    "dossierPage":         "readonly",
    "commandCenter":       "readonly"
  }
}
