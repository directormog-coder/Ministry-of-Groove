  "screenshots": [
    {
      "src": "assets/images/screenshot-mobile.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Secure Communication Grid - Mobile"
    },
    {
      "src": "assets/images/screenshot-desktop.png",
      "sizes": "1920x1080",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Command Center Interface - Desktop"
    }
  ],
  "shortcuts": [
    {
      "name": "Personnel Dossier",
      "short_name": "Dossier",
      "description": "Access operative profile and status",
      "url": "/pages/dossier.html",
      "icons": [
        {
          "src": "assets/images/shortcut-dossier.png",
          "sizes": "96x96"
        }
      ]
    },
    {
      "name": "Visual Archive",
      "short_name": "Gallery",
      "description": "Classified media assets",
      "url": "/pages/gallery.html",
      "icons": [
        {
          "src": "assets/images/shortcut-gallery.png",
          "sizes": "96x96"
        }
      ]
    },
    {
      "name": "Frequency Monitor",
      "short_name": "Frequency",
      "description": "Amapiano surveillance rankings",
      "url": "/pages/frequency.html",
      "icons": [
        {
          "src": "assets/images/shortcut-frequency.png",
          "sizes": "96x96"
        }
      ]
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+mog",
      "url": "/?protocol=%s"
    }
  ],
  "share_target": {
    "action": "/pages/gallery.html",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "name",
      "text": "description",
      "url": "link",
      "files": [
        {
          "name": "media",
          "accept": [
            "image/*",
            "video/*"
          ]
        }
      ]
    }
  },
  "related_applications": [],
  "prefer_related_applications": false,
  "handle_links": "preferred",
  "launch_handler": {
    "client_mode": ["navigate-existing", "auto"]
  },
  "edge_side_panel": {
    "preferred_width": 400
  }
}
