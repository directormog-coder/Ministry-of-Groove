# ==========================================
# MINISTRY OF GROOVE - ENVIRONMENT TEMPLATE
# ==========================================
# 1. Copy this file to .env
# 2. Fill in your actual values
# 3. NEVER commit .env to GitHub
# 4. Add values to Vercel Dashboard: Project Settings > Environment Variables

# ------------------------------------------
# SUPABASE (REQUIRED)
# ------------------------------------------
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key

# ------------------------------------------
# SUPABASE SERVICE ROLE (SERVER-SIDE ONLY)
# ------------------------------------------
# WARNING: This key has admin privileges. NEVER expose to client-side code.
# Use only in serverless functions, Edge Functions, or secure backend services.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ------------------------------------------
# OAUTH PROVIDERS (OPTIONAL)
# ------------------------------------------
# Google Sign-In Configuration
# Get these from Google Cloud Console: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# ------------------------------------------
# AUTHENTICATION & SECURITY
# ------------------------------------------
# JWT Secret for custom token signing (if not using Supabase Auth)
JWT_SECRET=your_random_256_bit_secret

# Encryption key for sensitive data (generate with: openssl rand -hex 32)
ENCRYPTION_KEY=your_64_character_hex_key

# Session configuration
SESSION_DURATION=86400
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=900

# ------------------------------------------
# STORAGE & CDN
# ------------------------------------------
# AWS S3 / CloudFront (Production Asset Hosting)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
S3_BUCKET=your_s3_bucket_name
CLOUDFRONT_DISTRIBUTION_ID=your_cloudfront_distribution_id

# Supabase Storage (Alternative/Staging)
STORAGE_BUCKET=mog-assets

# ------------------------------------------
# MONITORING & ERROR TRACKING
# ------------------------------------------
# Sentry.io configuration
SENTRY_DSN=your_sentry_dsn
SENTRY_AUTH_TOKEN=your_sentry_auth_token
SENTRY_ORG=ministry-of-groove
SENTRY_PROJECT=ncc-master

# LogRocket or alternative session replay
LOGROCKET_APP_ID=your_logrocket_app_id

# ------------------------------------------
# NOTIFICATIONS & COMMS
# ------------------------------------------
# Slack Webhooks
SLACK_WEBHOOK_URL=your_slack_webhook_for_deployments
SLACK_SECURITY_WEBHOOK_URL=your_slack_webhook_for_security_alerts

# Discord Webhook (alternative)
DISCORD_WEBHOOK_URL=your_discord_webhook_url

# Email service (Resend, SendGrid, etc.)
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=noreply@ministryofgroove.io

# ------------------------------------------
# APP CONFIGURATION
# ------------------------------------------
APP_NAME=Ministry of Groove
APP_VERSION=5.1.0
APP_ENV=production
APP_DEBUG=false

# Public URL (used for OAuth redirects, email links)
PUBLIC_URL=https://ministryofgroove.io

# ------------------------------------------
# FEATURE FLAGS
# ------------------------------------------
ENABLE_REALTIME=true
ENABLE_ANALYTICS=true
ENABLE_MAINTENANCE_MODE=false

# ------------------------------------------
# DEVELOPMENT ONLY
# ------------------------------------------
# These are only used in local development
DEV_SUPABASE_URL=http://localhost:54321
DEV_SUPABASE_ANON_KEY=your_local_anon_key

# Hot Module Replacement
HMR_PORT=24678

# ==========================================
# SECURITY CHECKLIST
# ==========================================
# [ ] All keys are rotated from default/placeholder values
# [ ] SUPABASE_SERVICE_ROLE_KEY is never used in client code
# [ ] ENCRYPTION_KEY is unique per environment
# [ ] JWT_SECRET is minimum 256 bits (64 hex characters)
# [ ] .env file is in .gitignore
# [ ] Production values are set in Vercel Dashboard, not in code
# [ ] No secrets are logged or exposed in error messages
# [ ] OAuth redirect URIs are registered with providers
# ==========================================
